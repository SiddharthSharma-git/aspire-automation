{
  "name": "aspire-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation framework for the Aspire Talent Acquisition platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test \"tests/UI Test\"",
    "test:api": "playwright test \"tests/API Test\"",
    "test:chrome": "playwright test --project=chromium",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.8.0"
  }
}
